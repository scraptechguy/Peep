// MARK: - Help

"helpHeading1" = "✨ This is Peep ✨";
"helpText1" = "...and this is how the home screen looks like. There's a lot you can do and learn from there...";
"helpHeading2" = "Your location 🗺️";
"helpText2" = "If you ever get lost, click on the location button in the bottom right corner. It will take you right to where you're at";
"helpHeading3" = "Current region and search 🧭";
"helpText3" = "At the top, you can see the name of the region you're viewing. Click this field and search for sundials by address!";
"helpHeading4" = "Search view 🔍";
"helpText4" = "You can search more then 7,000 sundials by address here. Search results also provide a distance as the crow flies and a short description if available";
"helpHeading5" = "Map pins aka sundials 📍";
"helpText5" = "Look for red points on the map, those represent a sundial. Zoom in on a red point until a pin appears, click on it and learn more!";
"helpHeading6" = "Sundial detail 🔬";
"helpText6" = "After clicking a pin, a sheet with information appears. You can snap the sheet into three different heights by dragging it";
"helpHeading7" = "Address, description,\nand other properties";
"helpText7" = "Here you can learn about what properties a sundial has and what they mean. Properties under the address and description (such as state) are expandable with a click. A sheet that then pops up explains what the properties mean in detail";
"helpHeading8" = "Gallery 🌉";
"helpText8" = "To help you find them, Peep gives you the option to view photos of almost all of the sundials. You can click on each photo and enjoy it in separate gallery view!";
"helpHeading9" = "Gallery view 🖼️";
"helpText9" = "The gallery view allows you to browse images in greater detail and also to save images into your camera roll ⇣";
"helpHeading10" = "Directions 🚗";
"helpText10" = "Peep plans the route to your desired sundial for you. Follow the directions inside the app or open the route in Apple Maps";
"helpHeading11" = "Settings ⚙️";
"helpText11" = "In settings, you can switch to light mode, change the preffered language of the app, and interact with the Peep project";

